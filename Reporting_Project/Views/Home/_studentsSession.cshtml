@model Frontend_Project.ViewModel.SessionDetailDTO


@Html.HiddenFor(x=>x.auditing_Session_ID)
@Html.HiddenFor(x=>x.study_Group_ID)



<div class="col">
        <div class="card mb-4">
            <div class="card-body">
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label"> Provider</label>
                    <div class="col-sm-10">
                        <div class="input-group input-group-merge">
                            <!--<span class="input-group-text"><i class="bx bx-envelope"></i></span>-->
                            <input type="text" asp-for="TrainingCenterName" class="form-control" disabled />

                        </div>
                        <!--<div class="form-text"> You can use letters, numbers & periods </div>-->
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label"> Job Profile</label>
                    <div class="col-sm-10">
                        <div class="input-group input-group-merge">
                            <!--<span class="input-group-text"><i class="bx bx-envelope"></i></span>-->
                            <input type="text" asp-for="TrainingCenterName" class="form-control" disabled />

                        </div>
                        <!--<div class="form-text"> You can use letters, numbers & periods </div>-->
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label"> Track</label>
                    <div class="col-sm-10">
                        <div class="input-group input-group-merge">
                            <!--<span class="input-group-text"><i class="bx bx-envelope"></i></span>-->
                            <input type="text" asp-for="TrainingCenterName" class="form-control" disabled />

                        </div>
                        <!--<div class="form-text"> You can use letters, numbers & periods </div>-->
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label"> Round Code</label>
                    <div class="col-sm-10">
                        <div class="input-group input-group-merge">
                            <!--<span class="input-group-text"><i class="bx bx-envelope"></i></span>-->
                            <input type="text" asp-for="TrainingCenterName" class="form-control" disabled />

                        </div>
                        <!--<div class="form-text"> You can use letters, numbers & periods </div>-->
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label"> Number of registered</label>
                    <div class="col-sm-10">
                        <div class="input-group input-group-merge">
                            <!--<span class="input-group-text"><i class="bx bx-envelope"></i></span>-->
                            <input type="text" asp-for="NumberRegistered" class="form-control" disabled />

                        </div>

                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label"> Meeting Link</label>
                    <div class="col-sm-10">
                        <div class="input-group input-group-merge">
                            <!--<span class="input-group-text"><i class="bx bx-envelope"></i></span>-->
                            <label class="col-sm-2 col-form-label" asp-for="MeetingLink"></label>

                        </div>
                        <!--<div class="form-text"> You can use letters, numbers & periods </div>-->
                    </div>
                </div>
            </div>
        </div>
    </div>




    <!-- Basic with Icons -->
    <div class="col">
        <div class="card mb-4">
            <div class="card-header d-flex align-items-center justify-content-between">
                <!--<h5 class="mb-0">Basic with Icons</h5>--> <small class="text-muted float-end">Merged input group</small>
            </div>
            <div class="card-body">
           



                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label">current Chapter</label>
                    <div class="col-sm-10">
                        <div class="input-group input-group-merge">
                            <span class="input-group-text"><i class="bx bx-envelope"></i></span>
                            <input type="text" asp-for="current_Chapter" class="form-control" placeholder="" aria-label="" aria-describedby="" />
                            <span id="basic-icon-default-email2" class="input-group-text">example.com</span>
                        </div>
                        <!--<div class="form-text"> You can use letters, numbers & periods </div>-->
                    </div>
                </div>



                <div class="row mb-3">

                    <label class="col-sm-2 col-form-label" for="basic-icon-default-email">Active</label>
                    <div class="col-sm-10">
                        <div class="list-group">
                            <label class="list-group-item">

                                <input class="form-check-input me-1" asp-for="Conducted" type="checkbox" value="true">
                            </label>
                        </div>

                    </div>

                </div>
                <div class="row mb-3">

                    <label class="col-sm-2 col-form-label" for="basic-icon-default-email">Physical Session?</label>
                    <div class="col-sm-10">
                        <div class="list-group">
                            <label class="list-group-item">

                                <input class="form-check-input me-1" asp-for="lab_Flag" type="checkbox" value="true">
                            </label>
                        </div>

                    </div>

                </div>

                <div class="row mb-3">

                    <label class="col-sm-2 col-form-label" for="basic-icon-default-email">Lab?</label>
                    <div class="col-sm-10">
                        <div class="list-group">
                            <label class="list-group-item">

                                <input class="form-check-input me-1" asp-for="lab_Flag" type="checkbox" value="true">
                            </label>
                        </div>

                    </div>

                </div>

                <div class="row mb-3">

                    <label class="col-sm-2 col-form-label" for="basic-icon-default-email">Test?</label>
                    <div class="col-sm-10">
                        <div class="list-group">
                            <label class="list-group-item">

                                <input class="form-check-input me-1" asp-for="test_Flag" type="checkbox" value="true">
                            </label>
                        </div>

                    </div>

                </div>

                <div class="row mb-3">

                    <label class="col-sm-2 col-form-label" for="basic-icon-default-email">Depi Logo shown?</label>
                    <div class="col-sm-10">
                        <div class="list-group">
                            <label class="list-group-item">

                                <input class="form-check-input me-1" asp-for="depi_Logo_Flag" type="checkbox" value="true">
                            </label>
                        </div>

                    </div>

                </div>

                <div class="row mb-3">

                    <label class="col-sm-2 col-form-label" for="basic-icon-default-email">Presentation Used?</label>
                    <div class="col-sm-10">
                        <div class="list-group">
                            <label class="list-group-item">

                                <input class="form-check-input me-1" asp-for="depi_Logo_Flag" type="checkbox" value="true">
                            </label>
                        </div>

                    </div>

                </div>


                <div class="row mb-3">

                    <label class="col-sm-2 col-form-label" for="basic-icon-default-email"> Material Delivered?</label>
                    <div class="col-sm-10">

                        <div class="list-group">
                            <label class="list-group-item">

                                <input class="form-check-input me-1" asp-for="MaterialDelivered" type="checkbox" value="true">
                            </label>
                        </div>



                    </div>

                </div>

                <div class="row mb-3">
                    <label for="exampleFormControlSelect2" class="col-sm-2 col-form-label">Connection Quality</label>
                    <div class="col-sm-10">

                        <div class="list-group">

                            <select class="form-select" asp-for="ConnectionQuality">
                                <!--onclick="SelectChange()"-->
                                <option value="Good">Good</option>
                                <option value="Average">Average</option>
                                <option value="Bad">Bad</option>

                            </select>
                            <span style="color:red" asp-validation-for="ConnectionQuality"></span>
                            <div class="form-text"> You have to chosse </div>
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <label for="exampleFormControlSelect2" class="col-sm-2 col-form-label">Voice Quality</label>
                    <div class="col-sm-10">

                        <div class="list-group">

                            <select class="form-select" asp-for="VoiceQuality">
                                <!--onclick="SelectChange()"-->
                                <option value="Good">Good</option>
                                <option value="Average">Average</option>
                                <option value="Bad">Bad</option>

                            </select>
                            <span style="color:red" asp-validation-for="VoiceQuality"></span>
                            <div class="form-text"> You have to chosse </div>
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <label for="exampleFormControlSelect2" class="col-sm-2 col-form-label">Video Quality</label>
                    <div class="col-sm-10">

                        <div class="list-group">

                            <select class="form-select" asp-for="VideoQuality">
                                <!--onclick="SelectChange()"-->
                                <option value="Good">Good</option>
                                <option value="Average">Average</option>
                                <option value="Bad">Bad</option>

                            </select>
                            <span style="color:red" asp-validation-for="VideoQuality"></span>
                            <div class="form-text"> You have to chosse </div>
                        </div>
                    </div>
                </div>
                
                <div class="row mb-3">

                    <label class="col-sm-2 col-form-label" for="basic-icon-default-email" id="lblstudent"></label>
                    <div class="col-sm-10" >










                        <div class="mb-3">
                            <label for="exampleFormControlSelect2" class="form-label">Instructor</label>

                            <select class="form-select" asp-for="Instructor_ID">
                                <!--onclick="SelectChange()"-->
                                <option>Open this select menu</option>
                                @if (Model.StudentsAttendedList.Count > 0)
                                {
                                    foreach (var item in Model.InstructorList)
                                    {
                                        if (item.Id != 0)
                                        {
                                            <option style="color: green;" value="@item.Id">@item.NameEN</option>
                                        }
                                        else
                                        {
                                            <option style="color: red;" value="@item.Id">@item.NameEN</option>
                                        }

                                    }
                                }
                            </select>
                            <span style="color:red" asp-validation-for="RoundCode"></span>

                            <label class="col-sm-2 col-form-label"> Other Instructor: </label>

                            <div class="mb-3">
                                <div class="input-group input-group-merge">
                                    <span class="input-group-text"><i class=""></i></span>
                                    <input type="text" asp-for="OtherInstructorName" class="form-control" />
                                    <!--<span id="basic-icon-default-email2" class="input-group-text">example.com</span>-->
                                </div>
                                <!--<div class="form-text"> You can use letters, numbers & periods </div>-->
                            </div>

                        </div>

                        <div>
                            <label class="col-sm-2 col-form-label"> Students List: </label>
                            <div class="list-group">
                                @Html.HiddenFor(x => x.reportStart)
                                @if (Model.StudentsAttendedList.Count > 0)
                                {

                                    for (int i = 0; i < Model.StudentsAttendedList.Count(); i++)
                                    {
                                        <label class="list-group-item">
                                            @Html.HiddenFor(x => x.StudentsAttendedList[i].Id)
                                            @Html.HiddenFor(x => x.StudentsAttendedList[i].NameAr)
                                            @Html.HiddenFor(x => x.StudentsAttendedList[i].NameEN)
                                            <input class="form-check-input me-1" asp-for="StudentsAttendedList[i].attend" type="checkbox" checked>
                                            @Model.StudentsAttendedList[i].NameAr
                                        </label>
                                    }

                                }
                                else
                                {

                                    <label class="list-group-item">
                                        There is no student in this session
                                    </label>
                                }
                            </div>
                        </div>

                        <div>
                            <label class="col-sm-2 col-form-label"> Remarks and Comments: </label>
                            <div class="mb-3">
                                <div class="input-group input-group-merge">
                                    <span class="input-group-text"><i class=""></i></span>
                                    <input type="textbox" asp-for="OtherInstructorName" class="form-control" />
                                    <!--<span id="basic-icon-default-email2" class="input-group-text">example.com</span>-->
                                </div>
                                <!--<div class="form-text"> You can use letters, numbers & periods </div>-->
                            </div>
                        </div>













                    </div>

                </div>
                <!--/ List group checkbox -->


            </div>
        </div>
    </div>




