@using Frontend_Project.ViewModel
@model SessionDetailDTO
@{
    ViewData["Title"] = "Home Page";
}

<h4 class="py-3 mb-4"><span class="text-muted fw-light">Forms/</span> Horizontal Layouts</h4>

    @if (ViewBag.suc != null)
    {
        <h4 class="alert alert-success">Save Successfull  </h4>
    }
    @if (ViewBag.fail != null)
    {
        <h4 class="alert alert-danger">Save Failed </h4>
    }
<!-- Basic Layout & Basic with Icons -->
 <form asp-action="AuditingReport" asp-controller="Home" method="post">
<div class="row">


        @Html.HiddenFor(x => x.AuditorId)
        <input type="text" asp-for="AuditorId" class="form-control" placeholder="" aria-label="" aria-describedby="" hidden />
        @Html.HiddenFor(x => x.reportStart)
    <!-- Basic with Icons -->
    <div class="col">
        <div class="card mb-4">
            <div class="card-header d-flex align-items-center justify-content-between">
                @* <h5 class="mb-0">Basic with Icons</h5> <small class="text-muted float-end">Merged input group</small> *@
            </div>
            <div class="card-body">
              

                    <div class="mb-3">
                        <label for="exampleFormControlSelect2" class="form-label">Example multiple select</label>
                        <input type="text" asp-for="RoundCode" class="form-control" hidden />
                       <!-- <select multiple class="form-select" asp-for="RoundCode" aria-label="Multiple select example" onchange="SelectChange()">-->
                        <select multiple class="form-select" id="RoundCodeSelector" aria-label="Multiple select example">
                        <!--onclick="SelectChange()"-->
                        <option>Open this select menu</option>
                        @foreach (var item in Model.sessions)
                        {
                            if(item.Doneflag ==0)
                            {
                                <option style="color: green;" value="@item.RoundCode">@item.RoundCode - @item.SessionDateTime</option>
                                }
                                else if (item.Doneflag == 1)
                                {
                                    <option style="color: yellow;" value="@item.RoundCode">@item.RoundCode - @item.SessionDateTime</option>
                            } else if (item.Doneflag == 2)
                                {
                                    <option style="color: black;" value="@item.RoundCode">@item.RoundCode - @item.SessionDateTime</option>
                            }else if (item.Doneflag == 9)
                                {
                                <option style="color: red;" value="@item.RoundCode">@item.RoundCode</option>
                            }
                            
                        }
                        </select>
                        <span style="color:red" asp-validation-for="RoundCode"></span>
                        <!--<div class="form-text"> You can use letters, numbers & periods </div>-->
                    </div>
                  

                    <div class="row justify-content-end">
                        <div class="col-sm-10">
                        <button type="button" class="btn btn-primary"  id="btnSend"  onclick="catchSessionID()">Send</button>
                      
                        </div>
                    </div>
            
            </div>
        </div>
    </div>




  
</div>

<div class="row" id="formSession" style="display:none">

    
































</div>

    <div class="row justify-content-end">
        <div class="col-sm-10">
            <button type="submit" class="btn btn-primary" id="btn_sub" style="display:none">Send</button>
        </div>
    </div>

</form>









@section script{
    <script>

        $(document).ready(function () {console.log("ready!");
            var formSessionID = document.getElementById("formSession");
           
        });
        function catchSessionID() {
             SelectChange();
            var RoundCodeSelected = document.getElementById("RoundCode");
            var sessionselect = document.getElementById("RoundCodeSelector");
            var formSessionID = document.getElementById("formSession");
            formSessionID.style.display = "block";
            var btn_sub = document.getElementById("btn_sub");
            btn_sub.style.display = "block";
            console.log("From button=>"+sessionselect.value);
           

        }
       

        

    </script>
   
}

